# ConeTuga needs no key, token or password to analyse scans (NFR-01). The explanations and the Q&A work without an
# LLM; the optional local model (Ollama, no key) is off by default and is turned on only in the terminal, with
# CONETUGA_LLM_MODEL (conetuga/explain/llm.py), never from this file.
# Copy this file to .env (gitignored, never committed) and fill in what you need: `python -m conetuga` reads the
# CONETUGA_* names below from .env; a variable already exported in the terminal wins.
#
# CONETUGA_HISTORY_DIR=          # where the scan history is kept; default .history/ in the repo folder (gitignored).
#                                # Only when EXPORTED in the terminal that starts both the CLI and the UI: the UI
#                                # doesn't read .env, so set here it would send `scan` into one history and leave
#                                # the UI on the default one, where a live scan would never show.
#
# The findings log on a blockchain (conetuga/ledger), optional: with these empty, the log stays on this computer.
# CONETUGA_CHAIN_RPC_URL=        # http://127.0.0.1:8545 for a local Anvil, or a Sepolia RPC URL (may hold an API key)
# CONETUGA_CHAIN_PRIVATE_KEY=    # a testnet-only key (Anvil prints ten); never a key that holds real money
# CONETUGA_CHAIN_CONTRACT=       # the address `python -m conetuga ledger deploy` prints
